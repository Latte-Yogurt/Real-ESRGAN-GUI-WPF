<Window x:Class="Real_ESRGAN_GUI_WPF.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Real_ESRGAN_GUI_WPF"
        mc:Ignorable="d"
        Title="关于 Real ESRGAN GUI"
        Width="600" Height="300"
        MinWidth="300" MinHeight="300"
        MaxWidth="600" MaxHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="12"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6*"/>
        </Grid.RowDefinitions>

        <Image x:Name="AppIcon" Grid.Row="1" Height="56"
               HorizontalAlignment="Center"
               Source="pack://application:,,,/Resources/icon/Yoimiya64-1.png"
               Margin="0,0,0,0"/>

        <TextBlock x:Name="TitleLabel" Grid.Row="3"
                   FontSize="20"
                   Text="Real ESRGAN GUI"
                   FontFamily="Ink Free, Segoe UI, Arial" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,0"/>

        <TextBlock Grid.Row="5" HorizontalAlignment="Center" Margin="0,0,0,0">
            <Hyperlink x:Name="GithubHyperlink" Click="Github_Click">
                <TextBlock x:Name="GithubText" FontSize="14" Text="Github主页" FontFamily="Microsoft YaHei Light, DengXian Light, Microsoft YaHei"/>
            </Hyperlink>
        </TextBlock>

        <TextBlock Grid.Row="7" HorizontalAlignment="Center" Margin="0,0,0,0">
            <Hyperlink x:Name="LicenseHyperlink" Click="License_Click">
                <TextBlock x:Name="LicenseText" FontSize="14" Text="许可证" FontFamily="Microsoft YaHei Light, DengXian Light, Microsoft YaHei"/>
            </Hyperlink>
        </TextBlock>

        <Button x:Name="ConfirmButton" Grid.Row="9"
                Width="80" Height="Auto"
                Content="确定"
                HorizontalAlignment="Center"
                Margin="0,0,0,0"
                Click="ConfirmButton_Click"/>

        <TextBlock x:Name="CopyrightLabel" Grid.Row="11"
                   FontSize="12"
                   Text="Copyright © 2024 LatteYogurt. All rights reserved."
                   FontFamily="Ink Free, Segoe UI, Arial"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Stretch"
                   Margin="0"
                   Padding="20,0"/>
    </Grid>
</Window>