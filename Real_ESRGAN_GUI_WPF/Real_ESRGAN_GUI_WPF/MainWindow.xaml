<Window x:Class="Real_ESRGAN_GUI_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Real_ESRGAN_GUI_WPF"
        mc:Ignorable="d"
        Title="Real ESRGAN"
        Width="300" Height="300"
        MinWidth="300" MinHeight="300"
        MaxWidth="300" MaxHeight="300"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="12"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#F7F7F7" Padding="4,2">
            <MenuItem x:Name="FileMenu" Header="文件">
                <MenuItem x:Name="FileOpenMenu" Header="打开" Click="FileOpenMenu_Click"/>
                <Separator/>
                <MenuItem x:Name="FileExitMenu" Header="退出" Click="FileExitMenu_Click"/>
            </MenuItem>

            <MenuItem x:Name="LanguageMenu" Header="语言">
                <MenuItem x:Name="LanguageSelectMenu" Header="选择语言">
                    <MenuItem x:Name="LangZhCN" Header="简体中文" Click="LangZhCN_Click"/>
                    <MenuItem x:Name="LangZhTW" Header="繁體中文" Click="LangZhTW_Click"/>
                    <MenuItem x:Name="LangEnUS" Header="English" Click="LangEnUS_Click"/>
                </MenuItem>
            </MenuItem>

            <MenuItem x:Name="AboutMenu" Header="关于">
                <MenuItem x:Name="AboutMenuItem" Header="Real ESRGAN GUI" Click="AboutMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ScaleLabel" Grid.Row="1" Grid.Column="0"
                       Text="放大倍数"
                       VerticalAlignment="Center" Margin="0" HorizontalAlignment="Center"/>
            <ComboBox x:Name="ScaleComboBox" Grid.Row="1" Grid.Column="1"
                      Height="26" Margin="0,3"
                      VerticalContentAlignment="Center"
                      SelectionChanged="ScaleComboBox_SelectionChanged"/>

            <TextBlock x:Name="ModelLabel" Grid.Row="3" Grid.Column="0"
                       Text="放大算法"
                       VerticalAlignment="Center" Margin="0" HorizontalAlignment="Center"/>
            <ComboBox x:Name="ModelComboBox" Grid.Row="3" Grid.Column="1"
                      Height="26" Margin="0,3"
                      VerticalContentAlignment="Center"
                      SelectionChanged="ModelComboBox_SelectionChanged"/>

            <TextBlock x:Name="ExtensionLabel" Grid.Row="5" Grid.Column="0"
                       Text="生成格式"
                       VerticalAlignment="Center" Margin="0" HorizontalAlignment="Center"/>
            <ComboBox x:Name="ExtensionComboBox" Grid.Row="5" Grid.Column="1"
                      Height="26" Margin="0,3"
                      VerticalContentAlignment="Center"
                      SelectionChanged="ExtensionComboBox_SelectionChanged"/>

            <CheckBox x:Name="HideProcessCheckBox" Grid.Row="7" Grid.Column="0"
                      Content="后台运行"
                      VerticalAlignment="Bottom"
                      Checked="HideProcessCheckBox_Changed"
                      Unchecked="HideProcessCheckBox_Changed" HorizontalAlignment="Left"/>
            <Button x:Name="SaveConfigButton" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"
                    Content="保存配置"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Padding="0,0" MinWidth="80" MinHeight="22"
                    Click="SaveConfigButton_Click"/>
        </Grid>
    </Grid>
</Window>